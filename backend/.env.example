JWT_SECRET=change-me-to-a-random-secret-in-production
FRED_API_KEY=ENTER_YOUR_NEW_FRED_KEY_HERE
# Required for SEC EDGAR requests; identify the application with a real contact.
SEC_USER_AGENT=StockDashboard/1.0 contact@example.com
PORT=3001
FRONTEND_URL=http://localhost:3002

# Schwab API (OAuth2 PKCE)
SCHWAB_CLIENT_ID=ENTER_YOUR_NEW_SCHWAB_CLIENT_ID_HERE
SCHWAB_CLIENT_SECRET=ENTER_YOUR_NEW_SCHWAB_CLIENT_SECRET_HERE
SCHWAB_CALLBACK_URL=https://127.0.0.1:3000
SCHWAB_TOKEN_PATH=./.schwab-token.json

# Gemini API Settings
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=dummy-key-for-local-dev

# Google Cloud Vertex AI Settings
GOOGLE_CLOUD_PROJECT=dumb-money-dashboard
GOOGLE_CLOUD_LOCATION=us-central1

# This was inserted by `prisma init`:
# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Finnhub (earnings calendar — primary source for next earnings dates)
# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=ENTER_YOUR_FINNHUB_API_KEY_HERE

# SQLite path is resolved relative to prisma/schema.prisma (i.e. backend/prisma/)
# so file:./dev.db = backend/prisma/dev.db
DATABASE_URL="file:./dev.db"
